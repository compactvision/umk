APP_NAME="Université Simon Kimbangu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true on the HTTPS production environment.
# Enable privacy-preserving HTTP threshold logs when the log sink is ready.
# OPERATIONS_HTTP_LOG=true
# OPERATIONS_HTTP_SLOW_MS=500

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@universitesk.net"
MAIL_FROM_NAME="Université Simon Kimbangu"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Adresse du service informé lors du remplacement d’un justificatif
ADMISSIONS_NOTIFICATION_EMAIL=contact@universitesk.net

# SEO: keep previews/local installations out of search indexes.
# Set the verified public HTTPS origin before enabling indexing in production.
SEO_SITE_URL=
SEO_INDEXABLE=false
SEO_ENFORCE_ORIGIN=false
GOOGLE_SITE_VERIFICATION=
# Optional Node SSR; PHP public HTML fallback remains available without it.
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# Utiliser les fichiers compilés pour un audit local sans arrêter Vite.
VITE_USE_BUILD=false

# Scénario académique fictif, uniquement via le seeder de démonstration.
DEMO_ACADEMIC_YEAR=
DEMO_ACCOUNTS_PASSWORD=
